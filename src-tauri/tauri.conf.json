{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "win-start",
  "version": "1.3.0",
  "identifier": "com.winstart.app",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "win-start",
        "width": 740,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "maxWidth": 1432,
        "maxHeight": 960,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "visible": false,
        "x": 0,
        "y": 0,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../resources/icons/icon.ico"]
  }
}
